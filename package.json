{
  "name": "onebench-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:standalone": "vite build --config vite.standalone.config.mjs && node scripts/prepare-standalone-build.mjs",
    "build": "npm run build:standalone && vite build && node scripts/prepare-sites-build.mjs",
    "build:pages": "npm run build:standalone && GITHUB_PAGES=true vite build && node scripts/prepare-sites-build.mjs && node scripts/verify-pages-build.mjs",
    "build:extension": "npm run build:standalone && ONEBENCH_TARGET=extension vite build && node scripts/prepare-extension-build.mjs && node scripts/verify-extension-build.mjs",
    "create:local": "node scripts/create-local-workbench.mjs",
    "create:shortcut": "node scripts/create-desktop-launcher.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate:templates": "node scripts/validate-template-packs.mjs",
    "validate:modules": "node scripts/validate-modules.mjs",
    "validate:registry": "node scripts/validate-community-registry.mjs",
    "update:registry": "node scripts/update-community-registry.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "vite-plugin-singlefile": "^2.3.0"
  }
}
