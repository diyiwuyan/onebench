{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onebench.dev/schema/module-1.0.0.json",
  "title": "OneBench Module Manifest",
  "type": "object",
  "required": ["format", "modules"],
  "properties": {
    "format": { "const": "onebench-module-manifest/v1" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "dataBoundary"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string" },
          "dataBoundary": { "enum": ["local", "configuration", "network-cached"] },
          "permissions": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
