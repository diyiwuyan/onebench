{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onebench.dev/schema/workspace-1.0.0.json",
  "title": "OneBench Workspace",
  "type": "object",
  "required": ["version", "id", "name", "sourcePack", "intent", "theme", "layout", "modules"],
  "properties": {
    "version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "sourcePack": { "type": "string", "minLength": 1 },
    "intent": { "type": "string", "maxLength": 200 },
    "profile": {
      "type": "object",
      "required": ["displayName", "avatarId"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 24 },
        "avatarId": { "type": "string", "minLength": 1, "maxLength": 40 }
      },
      "additionalProperties": false
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "theme": {
      "type": "object",
      "required": ["id", "name", "accent"],
      "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "accent": { "type": "string" } },
      "additionalProperties": false
    },
    "layout": { "enum": ["focus-first"] },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "enabled"],
        "properties": { "id": { "type": "string" }, "enabled": { "const": true } },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
