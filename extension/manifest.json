{
  "manifest_version": 3,
  "name": "一句工作台 · OneBench",
  "short_name": "OneBench",
  "version": "0.2.0",
  "description": "把自己的 OneBench 工作台作为 Chrome 或 Edge 的新标签页。数据默认只留在本机。",
  "homepage_url": "https://github.com/diyiwuyan/onebench",
  "minimum_chrome_version": "109",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "192": "icons/onebench-192.png",
    "512": "icons/onebench-512.png"
  }
}
